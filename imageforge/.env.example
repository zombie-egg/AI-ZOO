# ImageForge 对 PHP 的 Luna 兼容鉴权；生产环境请全部换成高强度随机值。
IMAGEFORGE_SECRET=change-me
IMAGEFORGE_SECRET_KEY=change-me-too
IMAGEFORGE_ACCESS_TOKEN=change-access-token

# 仅支付回调、Kiosk 终图轮询和内部调试使用，不能放到浏览器代码中。
IMAGEFORGE_INTERNAL_TOKEN=change-internal-token

# 最终成品签名链接的浏览器访问地址。Compose 本机验收使用 localhost:8000。
PUBLIC_BASE_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:4175,http://localhost:4175

# SQLite 与隔离文件目录。顾客原图、终图和打印文件必须位于 PRIVATE_DIR。
DATABASE_PATH=./data/imageforge.db
PRIVATE_DIR=./data/private

# 终图身份一致性自动质检参考阈值。
LOCK_THRESHOLD=0.55

# 图片质检阈值：平均亮度、过曝和拉普拉斯模糊度。
DARK_THRESHOLD=40
OVEREXPOSED_THRESHOLD=215
BLUR_THRESHOLD=40

# GPT-image-2 最多调用两次：首次生成；仅身份校验不通过时重试一次。
GPT_ATTEMPTS=2
GPT_TIMEOUT_S=120

# New API/OpenAI 兼容网关。你的中转站可直接填 https://www.codexapis.com/v1。
NEWAPI_BASE_URL=http://127.0.0.1:3000/v1
NEWAPI_TOKEN=
GPT_IMAGE_MODEL=gpt-image-2

# 生产环境固定使用 Gemini；自动化测试可临时设为 mock。
IMAGE_PROVIDER_OVERRIDE=gemini

# Gemini 原生 generateContent 接口。
FALLBACK_IMAGE_BASE_URL=https://api.relayrouter.ai
FALLBACK_IMAGE_API_KEY=
FALLBACK_IMAGE_MODEL=gemini-3.1-flash-image-preview

# FaceFusion CLI。local 表示可运行但只做开发降级；生产验收应设 facefusion。
FACE_ENGINE=local
FACEFUSION_PYTHON=python
FACEFUSION_ROOT=/opt/facefusion

# 终图签名链接默认 24 小时。
SIGNED_URL_TTL_S=86400
SIGNING_SECRET=change-signing-secret

# 当前实现为本地隔离目录；oss/qiniu/s3 作为后续对象存储适配值保留。
STORAGE_MODE=local

# 单个终图的成本估值（分），用于账单未返回逐图金额时估算。
GPT_IMAGE_ESTIMATED_COST_CENTS=30
PRINT_PAGE_WIDTH_MM=89
PRINT_PAGE_HEIGHT_MM=119
