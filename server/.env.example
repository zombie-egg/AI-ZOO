# 复制为 .env 后填写。生产环境保持 false，排障时短期开启后应立即关闭。
APP_DEBUG = false
# 国内部署使用 domestic。
ZONE = domestic

[APP]
DEFAULT_TIMEZONE = Asia/Shanghai

[DATABASE]
TYPE = mysql
# Docker Phase 1 使用 mysql；宝塔部署填写实际 MySQL 地址。
HOSTNAME =
DATABASE =
USERNAME =
# 禁止提交真实密码。
PASSWORD =
HOSTPORT = 3306
CHARSET = utf8mb4
DEBUG = false
PREFIX = ai_

[REDIS]
# Docker Phase 1 使用 redis；宝塔部署通常使用 127.0.0.1。
HOST=127.0.0.1
PORT=6379
PASSWORD=
SELECT=0

[CACHE]
driver=redis

[LANG]
default_lang = zh-cn

[PROJECT]
# 项目唯一标识：用于密钥加盐。项目初始化之后请不要轻易修改，否则可能导致后台账号密码失效。
UNIQUE_IDENTIFICATION = luna
# 生产与 Phase 1 均关闭演示环境。
DEMO_ENV = false

[PHASE1]
# 仅当官方 Luna 已不可用、需要本机复演原协议时开启；生产必须为 false。
OFFLINE_ACCEPTANCE = false

[LUNA]
BASE_URL = https://prod.luna.aws.iartai.com
OSS_BASE_URL = https://iart-user-upload-file.oss-cn-hangzhou.aliyuncs.com
# 仅离线验收桩使用；真实凭据仍由后台 ai_config 管理。
PHASE1_STUB_ENABLED = false
SECRET =
SECRET_KEY =

[IMAGEFORGE]
# PHP 只能走容器内网或 127.0.0.1；不要把此服务直接暴露公网。
BASE_URL = http://imageforge:8000
# 必须与 imageforge/.env 的 IMAGEFORGE_INTERNAL_TOKEN 完全一致。
INTERNAL_TOKEN =

[KIOSK]
# 此密钥由 Nginx 在受限 Kiosk 来源请求上注入，禁止编译进网页 JavaScript。
DEVICE_PROXY_TOKEN =
# 原始照片默认 7 天；未付款订单由业务逻辑保持 24 小时。
PHOTO_TTL_DAYS = 7
